# Select exactly one deployment-time provider.
# Allowed values: openai-compatible, openai-responses, anthropic
AGENT_PROVIDER=openai-compatible

# Required for openai-responses and anthropic. Never expose one to the browser.
AGENT_API_KEY=

# Required for openai-compatible. The chat provider appends /chat/completions.
AGENT_BASE_URL=http://localhost:10100/v1

# The client receives only id, label, and description through GET /api/agent/models.
# `model` never leaves the server. Set the default to one of the configured ids.
AGENT_DEFAULT_MODEL=gemini-3.8-flash-medium
AGENT_MODELS_JSON='[{"id":"gemini-3.8-flash-medium","model":"google-antigravity/gemini-3.8-flash-medium","label":"Gemini 3.8 Flash","description":"속도와 품질의 균형"},{"id":"gemini-3.8-flash-high","model":"google-antigravity/gemini-3.8-flash-high","label":"Gemini 3.8 Flash High","description":"꼼꼼한 초안 작성에 적합"},{"id":"gemini-3.8-flash-low","model":"google-antigravity/gemini-3.8-flash-low","label":"Gemini 3.8 Flash Low","description":"짧은 요청에 빠르게 응답"}]'
